<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Admin_Create_Account"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES" xmlns:viewmodel="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.VIEWMODEL" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Admin_Create_Account">

    <Grid x:Name="Grid_AdminAccount">
        <Border Width="600" Padding="25" CornerRadius="10" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
        </Border>

        <StackPanel>
            <!-- Title-->
            <TextBlock Text="Admin Account Creation"
                       FontSize="20" FontFamily="Arial Black" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,5,0,20"
                       Foreground="Green" Background="White"/>
            
            <!-- Name Section-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!--Labels -->
                    
                <TextBlock Text="Firstname" Grid.Column="0" Grid.Row="0" 
                           FontStyle="Normal" FontWeight="Bold" Margin="5" Foreground="Green"/>
                    
                <TextBlock Text="Middlename" Grid.Column="1" Grid.Row="0" 
                            FontStyle="Normal" FontWeight="Bold" Margin="5" Foreground="Green"/>
                    
                <TextBlock Text="Lastname" Grid.Column="2" Grid.Row="0" 
                        FontStyle="Normal" FontWeight="Bold" Margin="5" Foreground="Green"/>

                <!--Name Section-->
                    
                <TextBox Name="txtbox_AdminFname" Grid.Row="1" Grid.Column="0" Margin="5"
                         Height="30" VerticalAlignment="Center"
                         Text="{Binding Fname, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Name="txtbox_AdminMname" Grid.Row="1" Grid.Column="1" Margin="5"
                         Height="30" VerticalAlignment="Center"
                         Text="{Binding Mname, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Name="txtbox_AdminLname" Grid.Row="1" Grid.Column="2" Margin="6,0,4,0"
                         Height="30" VerticalAlignment="Center"
                         Text="{Binding  Lname, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Department" Grid.Row="2" Margin="10" Foreground="Green" FontWeight="Bold" 
                           FontStyle="Normal" />
            </Grid>

            <ComboBox Name="CmbboxAdminDept" IsEnabled="True" Height="35" Margin="5" 
                      ToolTip="Choose the Appropriate Department"
                      VerticalContentAlignment="Center"
                      SelectedItem="{Binding Admin_Dept, UpdateSourceTrigger = PropertyChanged}">
                <ComboBoxItem Content="SCIENCE"/>
                <ComboBoxItem Content="COMMERICAL"/>
                <ComboBoxItem Content="ARTS"/>
                <ComboBoxItem Content="ADMINISTRATION"/>
                <ComboBoxItem Content="FINANCE"/>
                <ComboBoxItem Content="STUDENT AFFAIRS"/>
                <ComboBoxItem Content="HEALTH"/>
                <ComboBoxItem Content="ICT / LAB"/>
            </ComboBox>

            <!-- Username & Password -->
            
            <Grid Margin="10" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Username" Margin="5" Foreground="Green" FontStyle="Normal" FontWeight="Bold"
                           Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="txtboxAdminUsername" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Height="30"
                         Text="{Binding Admin_Uname, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Margin="5" Foreground="Green" FontWeight="Bold" FontStyle="Normal"
                           Grid.Column="1" Grid.Row="0"/>
                <TextBox x:Name="txtboxAdminPassword" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Height="30"
                         Text="{Binding Admin_Password, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnCreatAccount" Click="BtnCreatAccount_Click"
                        ToolTip="Click to Submit your Form">
                    <Image Source="/IMAGES/Submit bttton.jpg" Width="100"/>
                    
                </Button>
                
            </WrapPanel>
        </StackPanel>
    </Grid>
</Page>
