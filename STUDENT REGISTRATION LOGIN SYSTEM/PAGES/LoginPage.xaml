<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LOGIN DASHBOARD">

    <Grid x:Name="Login_MainGrid">

        <Border 
            Width="500" Padding="25" CornerRadius="10" 
            VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- login details container -->

            <StackPanel>
                <!--Title -->
                <TextBlock Text="Student Login"
                           FontSize="30"
                           FontWeight="Bold"
                               Background="White"
                               Foreground="Green"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!--Student ID -->
                <TextBlock Text="Student ID" Foreground="Green"/>
                <TextBox x:Name="Txtbox_studentID" Height="30"
                         Margin="0,5,0,15"
                         Text="{Binding Student.StudentID}"/>

                <!--Password -->
                <TextBlock Text="Password" Foreground="Green"/>
                <PasswordBox x:Name="PsswdBox_Studentpassword"
                             Height="20"
                             Margin="0,5,0,20"/>

                <!--Login Button -->
                <Button x:Name="BtnLogin" ToolTip="proceed to login" Width="100" Click="BtnLogin_Click" 
                        >
                    <WrapPanel>
                        <Image Source="/IMAGES/Submit bttton.jpg" Width="100"/>
                        
                    </WrapPanel>
                </Button>

                <!--Message-->
                <TextBox Name="txtbox_message" Margin="0,10,0,0"
                         TextAlignment="Center" FontFamily="Times New Roman" FontStyle="Oblique"
                         Foreground="Red"
                         Text="{}"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>
