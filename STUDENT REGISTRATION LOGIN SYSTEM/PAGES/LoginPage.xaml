<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LOGIN DASHBOARD">

    <Grid x:Name="Login_MainGrid">

        <Border 
            Width="500" Padding="25" CornerRadius="10" 
            VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- login details container -->

            <StackPanel>
                <!--Title -->
                <TextBlock Text="Student Login"
                           FontSize="30"
                           FontWeight="Bold"
                               Background="White"
                               Foreground="Green"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!--Student ID -->
                <TextBlock Text="Student ID" Foreground="Green"/>
                <TextBox x:Name="Txtbox_studentID" Height="30"
                         Margin="0,5,0,15" Foreground="Green" FontFamily="Times New Roman" FontSize="18"
                         />

                <!--Password -->
                <TextBlock Text="Password" Foreground="Green"/>
                <PasswordBox x:Name="PsswdBox_Studentpassword"
                             Height="20"
                             Margin="0,5,0,20" Foreground="Green" FontSize="18"/>

                <!--Login Button -->
                <Button x:Name="BtnLogin" ToolTip="proceed to login" Width="100" Click="BtnLogin_Click" 
                        >
                    <WrapPanel>
                        <Image Source="/IMAGES/Submit bttton.jpg" Width="100"/>
                        
                    </WrapPanel>
                </Button>

                <!--Message-->
                <TextBox Name="txtbox_message" Margin="0,10,0,0"
                         TextAlignment="Center" FontFamily="Times New Roman" FontStyle="Oblique" Width="auto"
                         Foreground="Green" FontWeight="Bold" FontSize="15"
                         Text="if you havent Created an account, click the  SIGN-UP BUTTON below" 
                         IsEnabled="False"
                         />
                <!--REGISTER AS A NEW USER NAVIGATION BUTTON-->
                <Button Name="BtnNavigateToStudntRegPage" Margin="5" Width="60" Height="20" FontWeight="Bold" Foreground="White" Background="Green" Click="BtnNavigateToStudntRegPage_Click"
                        ToolTip="Click to Navigate to the Student Registration Page"> SIGN UP</Button>

                <!--RETRIEVE PASSWORD BUTTON-->
                    <Button Name="BtnForget_Password" Content="RETREIVE PASSWORD" FontStyle="Italic" FontWeight="Bold"
                        Background="green" Foreground="White" Width="130"
                        ToolTip="Click here to retieve your PASSWORD if forgotten, follow the steps displayed corrctly"
                        Click="BtnForget_Password_Click"    />

                <Button x:Name="Btn_Homepage" Content="HOMEPAGE" Click="Btn_Homepage_Click" Width="250"
                        FontSize="16" BorderThickness="2" Margin="10" 
                        ToolTip="Click the Button to Go back to the HomePage"
                        ToolTipService.ShowDuration ="4000">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>

                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
