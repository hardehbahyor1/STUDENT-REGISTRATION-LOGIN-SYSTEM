<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.AdministrationLandingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdministrationLandingPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition  Width="*"/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Orientation="Vertical" Grid.Column="0">
            <StackPanel.Resources>
                <Style TargetType="Button" x:Key="Btn_DesignFormat" >
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="Background" Value="Green"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="ToolTip" Value="Click to Continue."/>
                    <Setter Property="ToolTipService.InitialShowDelay" Value="5000"/>
                </Style>
            </StackPanel.Resources>

            <WrapPanel Margin="0,15">
                <Image Source="/IMAGES/-registration-icon-class-register-icon-png.png" Width="50"/>
                <TextBlock Text="MANAGEMENT DASHBOARD" Foreground="Green" FontSize="13.5" 
                           Margin="10,15,0,0" FontWeight="Bold"/>
            </WrapPanel>

            <Button x:Name="Btn_Result" Click="Btn_Result_Click" Style="{StaticResource Btn_DesignFormat}">
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/IMAGES/result image.jpg" Width="50" Margin="-19,0,0,0"/>
                    <TextBlock Text="RESULT DASHBOARD" VerticalAlignment="Center"/>
                </WrapPanel>
            </Button>

            <Button x:Name="Btn_courseReg" Click="Btn_courseReg_Click" Style="{StaticResource Btn_DesignFormat}">
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/IMAGES/-registration-icon-class-register-icon-png.png" Margin="0,0,5,0"/>
                    <TextBlock Text="COURSE REGISTRATION" VerticalAlignment="Center"/>
                </WrapPanel>
            </Button>

            <Button x:Name="Btn_studendDashboard" Click="Btn_studendDashboard_Click" Style="{StaticResource Btn_DesignFormat}">
                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/UC VIEW IMAGES/student result.jpg" Margin="9,0,5,0"/>
                    <TextBlock Text="STUDENT MANAGEMENT" VerticalAlignment="Center"/>
                </WrapPanel>
            </Button>

            <Button x:Name="Btn_staffDashboard" Click="Btn_staffDashboard_Click" Style="{StaticResource Btn_DesignFormat}">
                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/dashboard icon.png" Margin="0,0,10,0"/>
                    <TextBlock Text="STAFF MANAGEMENT" VerticalAlignment="Center"/>
                </WrapPanel>
            </Button>

            <Button x:Name="Btn_Logout" Click="Btn_Logout_Click" Style="{StaticResource Btn_DesignFormat}">
                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/logout image 2.jpg" Margin="-75,0,10,0"/>
                    <TextBlock Text="LOGOUT" VerticalAlignment="Center"/>
                </WrapPanel>
            </Button>

            <Button x:Name="Btn_homepage" Click="Btn_homepage_Click" ToolTip="Click to Go back to Homepage" ToolTipService.ShowDuration="5000" Style="{StaticResource Btn_DesignFormat}">
                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/Admin UC image/bckwrd button img.png" Margin="-55,0,10,0"/>
                    <TextBlock Text="HOME PAGE" VerticalAlignment="Center" FontSize="25"/>
                </WrapPanel>
            </Button>
        </StackPanel>
        
        <!-- MAIN CONTENT PAGE -->
        <Border Grid.Column="1" CornerRadius="10" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                
                <!--WELCOME MESSAGE GREETINGS -->
                <StackPanel Background="White" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="Txtblock_WelcomMssg" Foreground="Green" FontWeight="Bold" FontSize="18" 
                               FontFamily="Cascadia Mono"/>
                    
                    <TextBlock x:Name="TxtUserDetails" Foreground="Green" FontFamily="Cascadia Mono"/>
                </StackPanel>
                
                
                <!-- MAIN CONTENT -->
                <ScrollViewer Grid.Row="1">
                    <ContentControl x:Name="Admin_Landing_PageDashboard"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
