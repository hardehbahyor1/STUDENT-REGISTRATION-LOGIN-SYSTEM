<UserControl x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Admin_UC_Pages.UC_staffManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Admin_UC_Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Button" x:Key="BtnStyle">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Cascadia Mono"/>
        </Style>
    </UserControl.Resources>
    <Border Padding="5" CornerRadius="10" BorderThickness="2" BorderBrush="Green" Margin="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button x:Name="Btn_search" Click="Btn_search_Click" Style="{StaticResource BtnStyle}"
                    Content="🔍 Search" Height="40" Width="Auto" Margin="5" FontSize="20"
                    ToolTip="Click to Search for a Specific Staff Information with STAFF-ID." 
                    ToolTipService.InitialShowDelay="500"/>

                    <Button x:Name="Btn_delete" Click="Btn_delete_Click" Style="{StaticResource BtnStyle}"
                    Content="🗑 Delete" Height="40" FontSize="20" Width="Auto"
                    Margin="8" ToolTip="Proceed to Delete Staff Record From Database."
                    ToolTipService.InitialShowDelay="500"/>

                    <Button x:Name="Btn_staffList" Click="Btn_staffList_Click"  Style="{StaticResource BtnStyle}"
                    Content="📋 Staff List" Height="40" FontSize="20" Width="Auto" Margin="5"
                    ToolTip="Click to Show all Employeed registered Staff."
                    ToolTipService.InitialShowDelay="500"/>

                    <Button x:Name="Btn_edit" Click="Btn_edit_Click" Style="{StaticResource BtnStyle}"
                    Content="✏ Edit" Height="40" Margin="5" FontSize="20"
                    ToolTip="Edit/Upate Staff Information."
                    ToolTipService.InitialShowDelay="500"/>

                    <Button x:Name="Btn_showProfile" Click="Btn_showProfile_Click" Style="{StaticResource BtnStyle}"
                    Content="👁 View" Height="40" Margin="5" FontSize="20"
                    ToolTip="Show Staff Profile."
                    ToolTipService.InitialShowDelay="500"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Staff ID:" FontWeight="Bold" FontSize="20" Foreground="Green" Margin="5" />

                    <TextBox x:Name="Txtbox_Search_StaffID" IsEnabled="True" Width="300" Height="50"
                             FontFamily="Times New Roman" FontWeight="SemiBold" FontSize="25"
                             ToolTip="Enter the Staff ID to search."
                             TextAlignment="Left"
                             />
                    <ProgressBar x:Name="searchProgressbar" IsIndeterminate="True" Visibility="Collapsed" Height="20"/>
                </StackPanel>
            </Grid>

            <!-- 2nd Main Grid ROW-->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <!-- SEARCH & VIEW ALL STAFF RECORD COLOMN DEFINITION-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="Green" BorderThickness="3" Padding="5">
                        <StackPanel Margin="20">
                            <!--Staff Info Caption-->
                            <TextBlock Text="STAFF PROFILE DETAILS" FontSize="24" FontWeight="Bold" Foreground="DarkGreen"
                                       Margin="0,0,0,15" HorizontalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Staff ID:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaff_ID" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Name:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffname" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Gender:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffGender" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Marital Status:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffMaritalStatus" FontSize="20" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Address:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffAddress" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Nationality:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffNationality" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="State:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffState" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="LGA:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffLGA" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Mobile:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffMobile" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Department:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffDept" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Employment Type:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtStaffEmploymenttype" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Qualification:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtQualification" FontSize="20"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Year of Employment:" FontWeight="Bold"/>
                                <TextBlock x:Name="txtYearofEmployment" FontSize="20"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!--2nd Grid Coloumn UI Design-->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border  CornerRadius="10" Width="Auto" Height="Auto" Background="White" Margin="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                
                                <!--Total Staff UI 00-->
                                <Grid Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="1" Text="TOTAL STAFF" FontSize="15" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtTotalStaff" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                </Grid>
                                
                                <!--Male Count 01-->
                                <Grid Grid.Column="1" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="MALE" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtmaleStaff"  FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>

                                <!--Female COUNT 02-->
                                <Grid Grid.Column="2" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="FEMALE" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtfemaleStaff" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Degree COUNT 10-->
                                <Grid Grid.Row="1" Grid.Column="0" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="DEGREE" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtDegreeStaff" Text="Testing" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>

                                <!-- M.Sc COUNT 11-->
                                <Grid Grid.Row="1" Grid.Column="1" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="M.Sc" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtMScStaff" Text="Testing" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Ph.d COUNT 12-->
                                <Grid Grid.Row="1" Grid.Column="2" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Ph.D" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtPhdStaff" Text="Testing" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- ICT DEPT COUNT 20 -->
                                <Grid Grid.Row="2" Grid.Column="0" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="ICT Dept" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtICTStaff" Text="Testing" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Admin Dept Count 21-->
                                <Grid Grid.Row="2" Grid.Column="1" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Admin Dept" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtadminStaff" Text="Testing" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Teachers Count 22-->
                                <Grid Grid.Row="2" Grid.Column="2" Background="PaleGreen">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="👥" FontSize="35" Foreground="Green"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Teachers" FontWeight="Bold" FontSize="15" Foreground="Green"/>
                                        <TextBlock x:Name="txtteacherStaff" FontWeight="Bold" FontSize="15"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!--DataGrid for View All Staff UI Design-->
                        <DataGrid x:Name="StafflistDatagrid" Grid.Row="1" AlternatingRowBackground="#F5F5F5" FontWeight="Medium"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" FontSize="14" Margin="10"
                                  ItemsSource="{Binding staffList}">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Green"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="Margin" Value="5"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STAFF-ID"  Width="Auto" Binding="{Binding Admin_ID_No, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="NAME" Width="Auto" HeaderStringFormat="bold" Binding="{Binding AdminLastName, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="GENDER" Binding="{Binding AdminGender, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="ROLE" Binding="{Binding AdminROle, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header=" DEPT" Binding="{Binding AdminDept, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="E-mail ADDRESS" Binding="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="QUALIFICATION" Binding="{Binding AdminQualification, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
