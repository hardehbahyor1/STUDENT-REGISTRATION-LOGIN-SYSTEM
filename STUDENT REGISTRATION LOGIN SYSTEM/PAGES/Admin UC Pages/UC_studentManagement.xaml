<UserControl x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Admin_UC_Pages.UC_studentManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Admin_UC_Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        
        <!-- Static Recources Definiton-->
        <ScrollViewer.Resources>
            
            <!--Button-->
            <Style x:Key="BtnKey" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Green"/>
                <Setter Property="ToolTip" Value="Clcik to Continue"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            
            <!--Textblock-->
            <Style x:Key="txtblockKey" TargetType="TextBlock">
                <Setter Property="FontSize" Value="29"/>
                <Setter Property="FontFamily" Value="Cascadia Mono"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="5"/>
            </Style>
            
            <!-- Textbox-->
            <Style x:Key="textbox" TargetType="TextBox">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ScrollViewer.Resources>
        
        <Border Margin="5" BorderThickness="5" BorderBrush="Green">
            <!-- MAIN GRID-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- 00 ROW DEFINITION-->
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btn_NewStudent" Content="REGISTER NEW" Style="{StaticResource BtnKey}" Click="btn_NewStudent_Click"/>
                    <Button x:Name="btn_ListofStudent" Grid.Column="03" Content="STUDENT LIST" Style="{StaticResource BtnKey}" Click="btn_ListofStudent_Click"/>
                    <Button x:Name="btn_Editstudent" Grid.Column="02" Content="EDIT STUDENT" Style="{StaticResource BtnKey}" Click="btn_Editstudent_Click"/>
                    <Button x:Name="btn_SearchStudent" Grid.Column="01" Content="SEARCH" Style="{StaticResource BtnKey}" Click="btn_SearchStudent_Click"/>
                </Grid>

                <!-- 01 ROW DEFINITION-->
                <Grid Grid.Row="01" Margin="5" Width="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="search_txtblock" ToolTip="Input Student ID-NO to Search" FontSize="18" Width="190"
                             FontFamily="Times New Roman" Foreground="Green" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- 02 ROW DEFINITION -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- O0 GRID COLUMN DEFINITION -->
                    <Grid Margin="8" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Fname, Mname, Lname -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="FIRST NAME:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="fname_txt" Grid.Row="0" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MIDDLE NAME:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="Lname_txt" Grid.Row="1" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="MIDDLE NAME:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="Mname_txt" Grid.Row="2" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="GENDER:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="gender_txt" Grid.Row="3" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="CLASS:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="class_txt" Grid.Row="4" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="DEPARTMENT:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="department_txt" Grid.Row="5" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="DOB:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="dob_txt" Grid.Row="6" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <!-- PARENT INFOMATION -->
                        <TextBlock Grid.Row="7" Grid.Column="0"  Text="Parent Details" Foreground="Green" FontWeight="Bold" FontSize="25"
                                   Style="{StaticResource txtblockKey}" Margin="0,10,0,5"/>
                        
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="NAME:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="parentname_txt" Grid.Row="8" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="ADDRESS:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="address_txt" Grid.Row="9" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="MOBILE NO:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="mobile_txt" Grid.Row="10" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="OCCUPATION:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="occupation_txt" Grid.Row="11" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>
                        
                        <!-- STUDENT HEALTH INFO-->
                        <TextBlock Grid.Row="12" Grid.Column="0"  Text="Student Health" Foreground="Green" FontWeight="Bold" FontSize="25"
                                   Style="{StaticResource txtblockKey}" Margin="0,10,0,5"/>
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="BLOOD GROUP:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="bloodtype_txt" Grid.Row="13" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>

                        <TextBlock Grid.Row="14" Grid.Column="0" Text="ALLERGRIES:" Style="{StaticResource txtblockKey}" Foreground="Green"/>
                        <TextBox x:Name="allergries_txt" Grid.Row="14" Grid.Column="1" IsEnabled="False" Style="{StaticResource textbox}"/>
                    </Grid>
                    
                    <!-- 01 GRID COLUMN DEFINITION -->
                    <Border Grid.Column="1" BorderThickness="5" BorderBrush="Green">
                        <Grid Margin="8"  Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
