<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Registration">

    <Grid x:Name="Registration_Grid" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="947.5"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1">

            <!--STUDENT ID -->
            <WrapPanel Margin="0,10,5,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="ID NO:" FontWeight="Bold" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
               
                <TextBox x:Name="txtbox_Stdnt_ID" Width="200" TextWrapping="Wrap" BorderBrush="Black" BorderThickness="2"
                         FontFamily="Times New Roman" FontSize="15" 
                         Text="{Binding Student.Stdnt_ID, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="True"
                         IsEnabled="False"
                />
            </WrapPanel>

            <!--FIRSTNAME, MIDDLE NAME & LAST NAME -->
            <WrapPanel Margin="0,10,5,10" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="FIRST-NAME:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
           
                <TextBox x:Name="txtbox_fname" Width="200" TextWrapping="Wrap" BorderBrush="Black" BorderThickness="2"
                        FontFamily="Times New Roman" FontSize="15" 
                         Text="{Binding Student.Fname, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>

            <WrapPanel Margin="0,10,5,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="MIDDLE-NAME:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
               
                <TextBox x:Name="txtbox_Mname" Width="200" TextWrapping="Wrap" BorderBrush="Black" BorderThickness="2" 
                         FontFamily="Times New Roman" FontSize="15" 
                         Text="{Binding Student.Mname, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>

            <WrapPanel Margin="0,10,5,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="LAST-NAME:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
                
                <TextBox x:Name="txtbox_Lname" Width="200" TextWrapping="Wrap" BorderBrush="Black" BorderThickness="2" 
                         FontFamily="Times New Roman" FontSize="15" 
                         Text="{Binding Student.Lname, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>

            <!-- COUNTRY OF ORIGIN COMBO BOX -->

            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,15">
                <Label Content="COUNTRY:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
                <ComboBox Name="CountryComboBox" Width="150" BorderThickness="2" BorderBrush="Black" 
                          SelectionChanged="CountryComboBox_SelectionChanged"
                          SelectedItem="{Binding Student.Country, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>

                <Label Content="STATE:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White" Margin="5,0,0,0"/>
                <ComboBox Name="StateComboBox" Width="150" BorderThickness="2" BorderBrush="Black" 
                              SelectionChanged="StateComboBox_SelectionChanged"
                          SelectedItem="{Binding Student.State, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>

                <Label Content="LGA:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
                <ComboBox Name="LGAComboBox" Width="120" BorderThickness="2" BorderBrush="Black"
                          SelectedItem="{Binding Student.LocalGovtArea, UpdateSourceTrigger=PropertyChanged}">
                </ComboBox>
            </WrapPanel>

            <!-- SEX & DOB & EMAIL-->
            <WrapPanel Margin="0,15,0,0">
                <Label Content="DOB:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
                <DatePicker x:Name="DOB_Datepicker" SelectedDateFormat="Long" ToolTip="Select your date of birth"
                                DisplayDateEnd="{x:Static sys:DateTime.Today}"
                            SelectedDate="{Binding Student.DateOfBirth, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="SEX:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"  Margin="5,0,0,0"/>
                <ComboBox Name="Sex_Combobox" Width="70" BorderBrush="Black" BorderThickness="2" 
                          SelectedItem="{Binding Student.Gender, UpdateSourceTrigger=PropertyChanged}" >
                    <ComboBoxItem Content="select option" IsEnabled="False"/>
                    <ComboBoxItem Content="MALE"/>
                    <ComboBoxItem Content="FEMALE"/>
                   
                </ComboBox>

                <Label Content="Email:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"  Margin="5,0,0,0" />
                <TextBox x:Name="Email_Txtbox" AutoWordSelection="True" Width="500" FontFamily="Times New Roman" 
                         FontSize="15" BorderBrush="Black" BorderThickness="2"
                         Text="{Binding Student.Email, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>

            <!-- MOBILE_NO & RESIDENTIAL ADDRESS-->
            <WrapPanel Margin="0,15,0,0">
                <Label Content="MOBILE NO:" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White"/>
                <TextBox x:Name="MobileNo_txtbox" FontFamily="Times New Roman" FontSize="15" Width="100" BorderBrush="Black" BorderThickness="2"/>

                <Label Content="RESIDENTIAL ADDRESS" FontWeight="Medium" FontSize="20" FontFamily="Cascadia Code" Background="Green" Foreground="White" Margin="5,0,0,0"/>
                <TextBox x:Name="ResidentialAdd_txtbox" FontFamily="Times New Roman" FontSize="15" BorderThickness="2" 
                         BorderBrush="Black" Width="400" TextWrapping="Wrap"
                         Text="{Binding Student.Residential_Address, UpdateSourceTrigger=PropertyChanged}"/>
            </WrapPanel>

            <!--SUBMIT BUTTON -->
            <Button Margin="25" Width="100" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="Button_Click">
                <WrapPanel>
                    <Image Source="/IMAGES/Submit bttton.jpg" Width="100" ToolTip="Click to submit details"/>
                </WrapPanel>
            </Button>

            <TextBlock Background="White" Foreground="Green" FontFamily="Cascadia Code" 
                       FontWeight="Medium" FontSize="20" TextAlignment="Center"  Width="auto" TextWrapping="Wrap">
                <Italic>After a Successful </Italic>  <Bold> REGISTRATION, ENSURE </Bold> to write down your <Bold> USER-ID and PASSWORD</Bold> 
                which is by default your <Bold>LOGIN CREDENTIALS </Bold>
            </TextBlock>

        </StackPanel>
    </Grid>
</Page>
