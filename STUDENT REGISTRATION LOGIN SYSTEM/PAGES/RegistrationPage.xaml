<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="Registration"
      FontFamily="Segoe UI" FontSize="14" Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="750" HorizontalAlignment="Center">

            <TextBlock Text="Student Registration" FontSize="26" FontWeight="SemiBold" Foreground="#2B3035" Margin="0,0,0,25" HorizontalAlignment="Center"/>

            <Border Background="White" Padding="30" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1">
                <StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="ID NO:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#495057" />
                        <TextBox x:Name="txtbox_Stdnt_ID" Grid.Column="1" Padding="8,6" BorderThickness="1" BorderBrush="#CED4DA" Background="#E9ECEF"
                                 Text="{Binding Student.Stdnt_ID, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" IsEnabled="False" MaxWidth="250" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="First Name:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" />
                        <TextBox x:Name="txtbox_fname" Grid.Column="1" Padding="8,6" BorderThickness="1" BorderBrush="#CED4DA" 
                                 Text="{Binding Student.Fname, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Middle Name:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" />
                        <TextBox x:Name="txtbox_Mname" Grid.Column="1" Padding="8,6" BorderThickness="1" BorderBrush="#CED4DA" 
                                 Text="{Binding Student.Mname, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Last Name:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" />
                        <TextBox x:Name="txtbox_Lname" Grid.Column="1" Padding="8,6" BorderThickness="1" BorderBrush="#CED4DA" 
                                 Text="{Binding Student.Lname, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Separator Margin="0,10,0,20" Background="#DEE2E6"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Location:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" />

                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Country" FontSize="12" Foreground="#6C757D" Margin="0,0,0,2"/>
                                <ComboBox Name="CountryComboBox" Padding="6" BorderThickness="1" BorderBrush="#CED4DA" 
                                          SelectionChanged="CountryComboBox_SelectionChanged"
                                          SelectedItem="{Binding Student.Country, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="State" FontSize="12" Foreground="#6C757D" Margin="0,0,0,2"/>
                                <ComboBox Name="StateComboBox" Padding="6" BorderThickness="1" BorderBrush="#CED4DA" 
                                          SelectionChanged="StateComboBox_SelectionChanged"
                                          SelectedItem="{Binding Student.State, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="LGA" FontSize="12" Foreground="#6C757D" Margin="0,0,0,2"/>
                                <ComboBox Name="LGAComboBox" Padding="6" BorderThickness="1" BorderBrush="#CED4DA" 
                                          SelectedItem="{Binding Student.LocalGovtArea, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Demographics:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Date of Birth" FontSize="12" Foreground="#6C757D" Margin="0,0,0,2"/>
                                <DatePicker x:Name="DOB_Datepicker" Width="180" Padding="4" BorderThickness="1" BorderBrush="#CED4DA"
                                            SelectedDateFormat="Long" ToolTip="Select your date of birth" DisplayDateEnd="{x:Static sys:DateTime.Today}"
                                            SelectedDate="{Binding Student.DateOfBirth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Sex" FontSize="12" Foreground="#6C757D" Margin="0,0,0,2"/>
                                
                                <ComboBox Name="Sex_Combobox" Width="120" Padding="6" BorderThickness="1" BorderBrush="#CED4DA"
                                          SelectedValuePath="Content"
                                          SelectedValue="{Binding Student.Gender, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="Select option" IsEnabled="False" IsSelected="True"/>
                                    <ComboBoxItem> MALE </ComboBoxItem>
                                    <ComboBoxItem> FEMALE </ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,10,0,20" Background="#DEE2E6"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email Address:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" />
                        <TextBox x:Name="Email_Txtbox" Grid.Column="1" Padding="8,6" BorderThickness="1" BorderBrush="#CED4DA" 
                                 Text="{Binding Student.Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mobile No:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#495057" />
                        <TextBox x:Name="MobileNo_txtbox" Grid.Column="1" Padding="8,6" BorderThickness="1" BorderBrush="#CED4DA" MaxWidth="250" HorizontalAlignment="Left"
                                 Text="{Binding Student.PhoneNUmber, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Residential Address:" VerticalAlignment="Top" Margin="0,8,0,0" FontWeight="Medium" Foreground="#495057" />
                        <TextBox x:Name="ResidentialAdd_txtbox" Grid.Column="1" Padding="8,6" BorderThickness="1" BorderBrush="#CED4DA" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding Student.Residential_Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <Button Content="Submit Registration" Click="Button_Click" Height="45" Background="#198754" Foreground="White" 
                            FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Width="250" HorizontalAlignment="Center"
                            IsDefault="True">  <!--meaning that the keyboaard Enter button can be used as shortcut-->
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="Btn_Homepage" Content="HOMEPAGE" Click="Btn_Homepage_Click" Width="250"
                            FontSize="16" BorderThickness="2" Margin="10" 
                            ToolTip="Click the Button to Go back to the HomePage"
                            ToolTipService.ShowDuration ="4000">
                        
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        
                    </Button>

                </StackPanel>
            </Border>

            <TextBlock Margin="0,20,0,0" TextAlignment="Center" Foreground="#6C757D" FontSize="13">
                After a successful registration, ensure to write down your <Run FontWeight="SemiBold" Foreground="#2B3035">User-ID and Password</Run>,<LineBreak/>
                which are your default login credentials.
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</Page>