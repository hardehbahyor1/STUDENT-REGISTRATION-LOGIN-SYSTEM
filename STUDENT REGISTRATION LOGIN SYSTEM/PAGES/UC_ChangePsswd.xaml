<UserControl x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.UC_ChangePsswd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES" xmlns:object="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.OBJECT" d:DataContext="{d:DesignInstance Type=object:StudentInfo}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <StackPanel.Background>
                <ImageBrush ImageSource="/IMAGES/UC VIEW IMAGES/student image 1.jpg" 
                            Stretch="UniformToFill" 
                            Opacity="0.2"/>
            </StackPanel.Background>

            <TextBlock Text="Change Your Password" FontFamily="Cascadia Mono" FontWeight="Bold"
                       FontSize="30" Margin="0,20,0,0"
                       Background="Green" Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="For your security, please enter your current password to continue" 
                       FontFamily="Times New Roman" FontSize="25" FontStyle="Italic"
                       Foreground="Black"  HorizontalAlignment="Center"
                       Margin="5"/>

            <!-- ACCEPT USER CURRENT PASSWORD-->

            <StackPanel Orientation="Horizontal" Margin="50,10,0,0" HorizontalAlignment="Center">
                
                <Label Content="CURRENT PASSWORD" FontSize="15" FontWeight="Bold" Foreground="Green"/>
                
                <PasswordBox Name="txtbx_CurrentPsswrd" Width="200" Margin="10"
                         ToolTip="current password required in the coloum" 
                         ToolTipService.ShowDuration="3000"/>

                <Button x:Name="Btn_ConfirmPsswrd" Content="VERIFY" FontSize="20" FontWeight="Bold" 
                        Width="100" Background="LawnGreen" Foreground="White" 
                        Click="Btn_ConfirmPsswrd_Click"
                        IsDefault="False"/>
            </StackPanel>

            <StackPanel Margin="25,20,0,0" Orientation="Horizontal"  HorizontalAlignment="Center">
                <Label Content="NEW PASSWORD" FontSize="15" FontWeight="Bold" Foreground="Green"/>

                <PasswordBox Name="txtbx_NewPsswrd" Width="200" Margin="10,10,0,10"
                         ToolTip="New password required" ToolTipService.ShowDuration="3000" />

                <Button x:Name="Btn_SubmitNewPsswrd" Content="VERIFY" FontSize="20" FontWeight="Bold" 
                        Width="100" Margin="10" 
                        Background="LawnGreen" Foreground="White"
                       Click="Btn_SubmitNewPsswrd_Click"
                        IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
