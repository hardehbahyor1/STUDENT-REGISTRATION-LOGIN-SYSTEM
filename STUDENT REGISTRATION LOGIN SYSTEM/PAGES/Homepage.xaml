<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Homepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Homepage">

    <Grid Name="grid_HomepageMainPanel">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">

            <WrapPanel Width="auto" Height="100" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" >
                <Image Source="/IMAGES/contact image icon.png" Width="100"/>
                <Button x:Name="Btn_Register" Content="REGISTER" Click="Btn_Register_Click" Width="100"
                        Foreground="Green" FontSize="20" FontWeight="Bold" FontStyle="Normal" FontFamily="Cascadia Code"
                        ToolTip="Set up a new student account">
                </Button>
            </WrapPanel>

            <WrapPanel Width="auto" Height="100" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" >
                <Image Source="/IMAGES/login icon 3.jpg" Width="100"/>
                <Button x:Name="Btn_Login" Content="LOGIN" Click="Btn_Login_Click" Width="100"
                        Foreground="Green" FontSize="25" FontWeight="Bold" FontStyle="Normal" FontFamily="Cascadia Code"
                        ToolTip="Enter your credentials to continue">
                </Button>
            </WrapPanel>

            <WrapPanel Width="auto" Height="100" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/IMAGES/login image 2.jpg" Height="100" Width="100"/>
                <Button x:Name="Btn_AdminLogin" Content="ADMIN" Click="Btn_AdminLogin_Click"
                        Width="100"
                        Foreground="Green" FontSize="25" FontWeight="Bold" FontStyle="Normal" FontFamily="Cascadia Code"
                        ToolTip="Enter your credentials to continue">
                </Button>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="auto" Height="auto" Margin="0,0,0,-0">
            <TextBlock Text="Developed by Rehoboth Technologies Inc. All rights reserved"
                           Background="LightGreen" Foreground="White" FontFamily="Cascadia Code" TextWrapping="Wrap"
                           FontSize="20" Width="auto" TextAlignment="Center" Grid.Column="1" Margin="50,402,5,-480" 
                       />
        </StackPanel>
    </Grid>
</Page>
