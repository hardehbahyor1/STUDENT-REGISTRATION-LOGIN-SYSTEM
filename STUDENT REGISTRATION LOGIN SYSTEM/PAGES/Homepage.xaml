<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Homepage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Homepage">

    <Grid Name="grid_HomepageMainPanel">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Margin="0,50,0,40" HorizontalAlignment="Center" >
                    <TextBlock Text="SCHOOL" FontSize="30" FontWeight="Black" Foreground="Green" HorizontalAlignment="Center"/>
                    <TextBlock Text="PORTAL" FontSize="25" FontWeight="SemiBold" Foreground="Green" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,0" VerticalAlignment="Top">
                    <Button x:Name="Btn_Register" Click="Btn_Register_Click" Margin="0,5,0,15" Height="60"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Set up a new student account">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <Image Source="/IMAGES/contact image icon.png" Width="30" Height="30" Margin="15,0,20,0"/>
                            <TextBlock Text="REGISTER" FontSize="25" FontWeight="Bold" FontFamily="Cascadia Code" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="Btn_Login" Click="Btn_Login_Click" Margin="0,5,0,15" Height="60" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand" 
                            ToolTip="Enter your credentials to continue">
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <Image Source="/IMAGES/login icon 3.jpg" Width="30" Height="30" Margin="15,0,20,0"/>
                            <TextBlock Text="LOGIN" FontSize="25" FontWeight="Bold" FontFamily="Cascadia Code" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="Btn_AdminLogin" Click="Btn_AdminLogin_Click" Margin="0,5,0,15" Height="60" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Admin Access">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="200">
                            <Image Source="/IMAGES/login icon 3.jpg" Width="30" Height="30" Margin="15,0,20,0"/>
                            <TextBlock Text="STAFF/ADMIN" Width="Auto" FontSize="25" FontWeight="Bold" FontFamily="Cascadia Code" Foreground="#2E7D32" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Column="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Welcome to Student Portal"
               FontSize="60"
               FontWeight="Bold"
               Foreground="#2E7D32"
               HorizontalAlignment="Center"/>

                <TextBlock Text="Select an option from the left menu to continue"
               FontSize="30" FontWeight="Bold"
               Margin="0,10,0,0"
               Opacity="0.8"
               TextAlignment="Center"/>
            </StackPanel>
            
            <Border VerticalAlignment="Bottom" Background="#2E7D32" Padding="12">
                <TextBlock Text="Developed by Rehoboth Technologies Inc. | All rights reserved. © 2026"
               Foreground="White" FontSize="14" FontFamily="Cascadia Mono"
               HorizontalAlignment="Center" Width="Auto"/>
            </Border>
        </Grid>
    </Grid>
</Page>
