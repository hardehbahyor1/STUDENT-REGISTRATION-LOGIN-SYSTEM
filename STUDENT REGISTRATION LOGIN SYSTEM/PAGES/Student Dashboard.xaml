<Page x:Class="STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES.Student_Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:STUDENT_REGISTRATION_LOGIN_SYSTEM.PAGES"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Student_Dashboard"
      Background="Transparent" 
      FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--SideBAR -->
        <StackPanel Orientation="Vertical" Grid.Column="0" >
            <StackPanel.Resources>
                <Style TargetType="Button" x:Key="Btn_Designformat">
                    <Setter Property="Background" Value="Green"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="bold"/>
                    <Setter Property="ToolTip" Value="Click to Continue"/>
                    <Setter Property="Margin" Value="10"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                    <Setter Property="ToolTipService.ShowDuration" Value="4000"/>
                </Style>
            </StackPanel.Resources>

            <WrapPanel>
                <TextBlock Text="Dashboard"
                    Foreground="Green"
                    FontSize="20"
                    Margin="55,20,10,25"
                    FontWeight="Bold">
                    <Image Source="/IMAGES/dashboard icon.png" Width="50" Margin="-50,0,0,0"/>
                </TextBlock>
            </WrapPanel>

            

            <!--BUTTON -->
            <Button Name="Btn_UpdateBiodata" Style="{StaticResource Btn_Designformat}" 
                        ToolTip="Update your personal details" 
                        Click="Btn_UpdateBiodata_Click">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/contact image icon.png"/>
                    <TextBlock Text="UPDATE BIODATA" Margin="10,5,0,15"/>
                </WrapPanel>
            </Button>

            <Button Name="Btn_RegisterCourse" Style="{StaticResource Btn_Designformat}" 
                    ToolTip="Register for your courses"
                    Click="Btn_RegisterCourse_Click">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/-registration-icon-class-register-icon-png.png"/>
                    <TextBlock Text="CLASS SUBJECT" Margin="10,5,0,15"/>
                </WrapPanel>
            </Button>


            <Button                    
                    Name="Btn_ViewResults" Style="{StaticResource Btn_Designformat}" 
                    ToolTip="View your academic results"
                    Click="Btn_ViewResults_Click">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/result image.jpg" Margin="-20,0,0,0"/>
                    <TextBlock Text="MY RESULTS" Margin="10,5,0,15"/>
                </WrapPanel>
            </Button>

            <Button Name="Btn_Hostel" Style="{StaticResource Btn_Designformat}"
                    ToolTip="Manage hostel accomodation"
                    Click="Btn_Hostel_Click">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/Student hostel.jpg" Margin="-39,0,0,0"/>
                    <TextBlock Text="ACCOMODATION" Margin="10,5,0,15"/>
                </WrapPanel>
            </Button>

            <Button Name="Btn_changePsswd" Style="{StaticResource Btn_Designformat}"
                    ToolTip="Change your account password"
                    Click="Btn_changePsswd_Click">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/IMAGES/password reset Image.png" Margin="10,0,0,0"/>
                    <TextBlock Text="CHANGE PASSWORD" Margin="10,5,0,15"/>
                </WrapPanel>
            </Button>

            <Button Name="btn_Logout" Style="{StaticResource Btn_Designformat}" 
                    ToolTip="Log out of your account"
                    Click="btn_Logout_Click">
                <WrapPanel>
                    <Image Source="/IMAGES/logout image 2.jpg" Width="30" Margin="-49,0,0,0"/>
                    <TextBlock Text="LOG OUT" Margin="10,5,0,15"/>
                </WrapPanel>
            </Button>
        </StackPanel>

        <!-- MAIN CONTENT PAGE -->
        <Border Grid.Column="1" CornerRadius="10" Margin="10" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 🔝 TOP USER INFO -->
                <StackPanel Background="#E8F5E9">
                    <TextBlock x:Name="TxtWelcome"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Green"/>

                    <TextBlock x:Name="TxtUserDetails"
                       FontSize="13"/>
                </StackPanel>

                <!-- 📄 MAIN CONTENT -->
                <ScrollViewer Grid.Row="1">
                    <ContentControl x:Name="MainContentFrame"/>
                </ScrollViewer>

            </Grid>
        </Border>
    </Grid>
</Page>
